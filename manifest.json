{
  "manifest_version": 3,
  "name": "Did You Really Get That?",
  "version": "0.1.1",
  "description": "Create a quick comprehension check from the article you are reading.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Did you really get that?",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/article-reader.js"],
      "css": ["content/highlight.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "comprehension-checker@example.local",
      "strict_min_version": "109.0"
    }
  }
}
